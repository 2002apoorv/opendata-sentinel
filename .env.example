# OpenData Sentinel Environment Configuration Example
PROJECT_NAME="OpenData Sentinel"
VERSION="1.0.0"
API_V1_STR="/api"

# Local SQLite Database Path
DATABASE_URL="sqlite:///./data/sentinel.db"

# Security & Upload Limitations
MAX_UPLOAD_SIZE_MB=50
REQUEST_TIMEOUT_SECONDS=15
MAX_DOWNLOAD_SIZE_BYTES=52428800

# CORS Allowed Origins (Comma-separated or list)
CORS_ORIGINS=["http://localhost:5173","http://localhost:3000","http://127.0.0.1:5173","http://127.0.0.1:3000"]
